node_modules/
dist/
build/
.cache/
.env*
# Two env files carry no secrets and must be versioned: the documented template, and
# the release layer that keeps a developer's .env.local out of a deployable bundle.
# .env, .env.local and .env.production.local stay ignored.
!.env.example
!.env.production
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Account-scoped MCP proxy wiring (a session-bound proxy route id plus token
# placeholders). Agent tooling config, not product source, and not something to
# publish alongside the release.
/.mcp.json

# Playwright run output: failure snapshots, reports and downloads. Regenerated by
# `pnpm test:e2e`, never versioned.
/test-results/
/playwright-report/
/blob-report/
/.playwright/
